generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum ServiceType {
  LUNCH
  DINNER
}

enum RoomServiceAvailabilityPolicy {
  DEFAULT_AVAILABLE
  EXPLICIT_ONLY
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SpecialDateScope {
  ALL
  LUNCH
  DINNER
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

enum ReservationOrigin {
  STAFF
  PHONE
  PUBLIC
}

enum PrivacyConsentMethod {
  VERBAL
  STAFF_RECORDED
  WEB_CHECKBOX
}

enum PublicReservationRateLimitAction {
  AVAILABILITY
  CREATE
  VIEW
  UPDATE
  CANCEL
}

enum ReservationAuditAction {
  CREATED
  UPDATED
  CANCELLED
  ASSIGNED
  REASSIGNED
  UNASSIGNED
}

enum PublicContentLocale {
  IT
  EN
}

enum PublicContentKey {
  BOOKING_PAGE_TITLE
  BOOKING_PAGE_INTRO
  UNAVAILABLE_MESSAGE
  CONTACT_PROMPT
  CONFIRMATION_MESSAGE
  MANAGEMENT_PAGE_TITLE
  MANAGEMENT_PAGE_INTRO
}

model Restaurant {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String
  timezone                    String
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  users                       User[]
  rooms                       Room[]
  weeklySchedules             WeeklyServiceSchedule[]
  bookingSettings             RestaurantBookingSettings?
  bookingCutoffRules          BookingCutoffRule[]
  specialDateOverrides        SpecialDateOverride[]
  reservations                Reservation[]
  reservationIdempotencyKeys  ReservationIdempotencyKey[]
  publicReservationRateLimits PublicReservationRateLimit[]
  reservationAuditEvents      ReservationAuditEvent[]
  auditEvents                 AuditEvent[]
  serviceInstances            ServiceInstance[]
  publicSettings              RestaurantPublicSettings?
  publicContents              PublicContent[]

  @@map("restaurants")
}

model RestaurantPublicSettings {
  restaurantId         String     @id @map("restaurant_id") @db.Uuid
  publicPhone          String     @map("public_phone") @db.VarChar(16)
  publicBookingBaseUrl String     @map("public_booking_base_url") @db.VarChar(255)
  publicEmail          String?    @map("public_email") @db.VarChar(254)
  whatsappNumber       String?    @map("whatsapp_number") @db.VarChar(16)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@index([restaurantId], map: "restaurant_public_settings_restaurant_idx")
  @@map("restaurant_public_settings")
}

model PublicContent {
  id           String              @id @default(uuid()) @db.Uuid
  restaurantId String              @map("restaurant_id") @db.Uuid
  locale       PublicContentLocale
  contentKey   PublicContentKey    @map("content_key")
  contentText  String              @map("content_text") @db.Text
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, locale, contentKey], map: "public_contents_restaurant_locale_key_key")
  @@index([restaurantId, locale, contentKey], map: "public_contents_restaurant_locale_key_idx")
  @@map("public_contents")
}

model Room {
  id                        String                        @id @default(uuid()) @db.Uuid
  restaurantId              String                        @map("restaurant_id") @db.Uuid
  name                      String                        @db.VarChar(80)
  code                      String                        @db.VarChar(80)
  serviceAvailabilityPolicy RoomServiceAvailabilityPolicy @default(DEFAULT_AVAILABLE) @map("service_availability_policy")
  displayOrder              Int                           @default(0) @map("display_order")
  isActive                  Boolean                       @default(true) @map("is_active")
  createdAt                 DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  restaurant                Restaurant                    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  diningTables              DiningTable[]
  serviceAvailabilities     ServiceRoomAvailability[]
  reservationAssignments    ReservationAssignment[]
  reservationAssignmentRows ReservationAssignmentTable[]  @relation("ReservationAssignmentTableRoom")

  @@unique([restaurantId, code], map: "rooms_restaurant_id_code_key")
  @@unique([restaurantId, name], map: "rooms_restaurant_id_name_key")
  @@unique([restaurantId, id], map: "rooms_restaurant_id_id_key")
  @@index([restaurantId, isActive, displayOrder], map: "rooms_restaurant_active_order_idx")
  @@map("rooms")
}

model ServiceInstance {
  id                 String                    @id @default(uuid()) @db.Uuid
  restaurantId       String                    @map("restaurant_id") @db.Uuid
  localDate          DateTime                  @map("local_date") @db.Date
  serviceType        ServiceType               @map("service_type")
  version            Int                       @default(1)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  restaurant         Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  roomAvailabilities ServiceRoomAvailability[]

  @@unique([restaurantId, localDate, serviceType], map: "service_instances_restaurant_date_service_key")
  @@unique([restaurantId, id], map: "service_instances_restaurant_id_id_key")
  @@index([restaurantId, localDate, serviceType], map: "service_instances_restaurant_date_service_idx")
  @@map("service_instances")
}

model ServiceRoomAvailability {
  id                String          @id @default(uuid()) @db.Uuid
  restaurantId      String          @map("restaurant_id") @db.Uuid
  serviceInstanceId String          @map("service_instance_id") @db.Uuid
  roomId            String          @map("room_id") @db.Uuid
  isAvailable       Boolean         @map("is_available")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  serviceInstance   ServiceInstance @relation(fields: [restaurantId, serviceInstanceId], references: [restaurantId, id], onDelete: Restrict, map: "service_room_availability_restaurant_instance_fkey")
  room              Room            @relation(fields: [restaurantId, roomId], references: [restaurantId, id], onDelete: Restrict, map: "service_room_availability_restaurant_room_fkey")

  @@unique([serviceInstanceId, roomId], map: "service_room_availability_instance_room_key")
  @@index([restaurantId, serviceInstanceId], map: "service_room_availability_restaurant_instance_idx")
  @@index([restaurantId, roomId], map: "service_room_availability_restaurant_room_idx")
  @@map("service_room_availability")
}

model DiningTable {
  id                        String                       @id @default(uuid()) @db.Uuid
  roomId                    String                       @map("room_id") @db.Uuid
  name                      String                       @db.VarChar(40)
  minimumSeats              Int                          @map("minimum_seats")
  maximumSeats              Int                          @map("maximum_seats")
  isActive                  Boolean                      @default(true) @map("is_active")
  displayOrder              Int                          @default(0) @map("display_order")
  createdAt                 DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  room                      Room                         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reservationAssignmentRows ReservationAssignmentTable[]

  @@unique([roomId, name], map: "dining_tables_room_id_name_key")
  @@unique([roomId, id], map: "dining_tables_room_id_id_key")
  @@index([roomId, isActive, displayOrder], map: "dining_tables_room_active_order_idx")
  @@map("dining_tables")
}

model WeeklyServiceSchedule {
  id                  String      @id @default(uuid()) @db.Uuid
  restaurantId        String      @map("restaurant_id") @db.Uuid
  dayOfWeek           DayOfWeek   @map("day_of_week")
  serviceType         ServiceType @map("service_type")
  isEnabled           Boolean     @default(true) @map("is_enabled")
  startTime           DateTime    @map("start_time") @db.Time(0)
  endTime             DateTime    @map("end_time") @db.Time(0)
  slotIntervalMinutes Int         @map("slot_interval_minutes")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  restaurant          Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek, serviceType], map: "weekly_schedules_restaurant_day_service_key")
  @@index([restaurantId, serviceType, isEnabled], map: "weekly_schedules_restaurant_service_enabled_idx")
  @@map("weekly_service_schedules")
}

model RestaurantBookingSettings {
  restaurantId                String     @id @map("restaurant_id") @db.Uuid
  rollingCapacityCovers       Int        @map("rolling_capacity_covers")
  rollingWindowMinutes        Int        @map("rolling_window_minutes")
  lunchModificationCutoff     DateTime   @map("lunch_modification_cutoff") @db.Time(0)
  dinnerModificationCutoff    DateTime   @map("dinner_modification_cutoff") @db.Time(0)
  managementLinkDurationHours Int        @default(24) @map("management_link_duration_hours")
  createdAt                   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  restaurant                  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_booking_settings")
}

model BookingCutoffRule {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  dayOfWeek    DayOfWeek   @map("day_of_week")
  serviceType  ServiceType @map("service_type")
  isEnabled    Boolean     @default(false) @map("is_enabled")
  cutoffTime   DateTime    @map("cutoff_time") @db.Time(0)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek, serviceType], map: "booking_cutoff_rules_restaurant_day_service_key")
  @@index([restaurantId, isEnabled, dayOfWeek, serviceType], map: "booking_cutoff_rules_restaurant_enabled_idx")
  @@map("booking_cutoff_rules")
}

model SpecialDateOverride {
  id                    String           @id @default(uuid()) @db.Uuid
  restaurantId          String           @map("restaurant_id") @db.Uuid
  date                  DateTime         @db.Date
  scope                 SpecialDateScope
  isClosed              Boolean          @default(false) @map("is_closed")
  specialStartTime      DateTime?        @map("special_start_time") @db.Time(0)
  specialEndTime        DateTime?        @map("special_end_time") @db.Time(0)
  specialCapacityCovers Int?             @map("special_capacity_covers")
  operationalNotes      String?          @map("operational_notes") @db.VarChar(500)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt            DateTime?        @map("archived_at") @db.Timestamptz(3)
  restaurant            Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date, scope], map: "special_dates_restaurant_date_scope_key")
  @@index([restaurantId, date, archivedAt], map: "special_dates_restaurant_date_archived_idx")
  @@map("special_date_overrides")
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  restaurantId           String                  @map("restaurant_id") @db.Uuid
  username               String                  @db.VarChar(64)
  passwordHash           String                  @map("password_hash") @db.VarChar(255)
  role                   UserRole
  isActive               Boolean                 @default(true) @map("is_active")
  mustChangePassword     Boolean                 @default(false) @map("must_change_password")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  disabledAt             DateTime?               @map("disabled_at") @db.Timestamptz(3)
  restaurant             Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  sessions               Session[]
  createdReservations    Reservation[]
  reservationAuditEvents ReservationAuditEvent[] @relation("ReservationAuditActor")
  auditEvents            AuditEvent[]            @relation("AuditEventActor")
  initialAssignments     ReservationAssignment[] @relation("ReservationAssignmentAssignedBy")
  updatedAssignments     ReservationAssignment[] @relation("ReservationAssignmentUpdatedBy")

  @@unique([restaurantId, username], map: "users_restaurant_id_username_key")
  @@unique([restaurantId, id], map: "users_restaurant_id_id_key")
  @@index([restaurantId, role, isActive], map: "users_restaurant_role_active_idx")
  @@map("users")
}

model Session {
  id         String    @id @db.Uuid
  secretHash String    @map("secret_hash") @db.Char(64)
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "sessions_user_id_expires_at_idx")
  @@index([expiresAt, revokedAt], map: "sessions_expires_at_revoked_at_idx")
  @@map("sessions")
}

model LoginRateLimit {
  keyHash         String    @id @map("key_hash") @db.Char(64)
  attempts        Int       @default(0)
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt], map: "login_rate_limits_expires_at_idx")
  @@map("login_rate_limits")
}

model Reservation {
  id                     String                      @id @default(uuid()) @db.Uuid
  restaurantId           String                      @map("restaurant_id") @db.Uuid
  localDate              DateTime                    @map("local_date") @db.Date
  serviceType            ServiceType                 @map("service_type")
  arrivalTime            DateTime                    @map("arrival_time") @db.Time(0)
  partySize              Int                         @map("party_size")
  status                 ReservationStatus           @default(CONFIRMED)
  origin                 ReservationOrigin
  customerFirstName      String                      @map("customer_first_name") @db.VarChar(80)
  customerLastName       String                      @map("customer_last_name") @db.VarChar(80)
  customerPhone          String                      @map("customer_phone") @db.VarChar(40)
  customerEmail          String?                     @map("customer_email") @db.VarChar(254)
  notes                  String?                     @db.VarChar(1000)
  preferences            String?                     @db.VarChar(1000)
  allergies              String?                     @db.VarChar(1000)
  privacyPolicyVersion   String                      @map("privacy_policy_version") @db.VarChar(64)
  privacyConsentAt       DateTime                    @map("privacy_consent_at") @db.Timestamptz(3)
  privacyConsentMethod   PrivacyConsentMethod        @map("privacy_consent_method")
  termsPolicyVersion     String?                     @map("terms_policy_version") @db.VarChar(64)
  termsConsentAt         DateTime?                   @map("terms_consent_at") @db.Timestamptz(3)
  termsConsentMethod     PrivacyConsentMethod?       @map("terms_consent_method")
  consentLanguage        String?                     @map("consent_language") @db.VarChar(2)
  createdByUserId        String?                     @map("created_by_user_id") @db.Uuid
  capacityOverride       Boolean                     @default(false) @map("capacity_override")
  capacityOverrideReason String?                     @map("capacity_override_reason") @db.VarChar(500)
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  cancelledAt            DateTime?                   @map("cancelled_at") @db.Timestamptz(3)
  version                Int                         @default(1)
  restaurant             Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdByUser          User?                       @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  idempotencyKey         ReservationIdempotencyKey?
  managementToken        ReservationManagementToken?
  auditEvents            ReservationAuditEvent[]
  assignment             ReservationAssignment?

  @@unique([restaurantId, id], map: "reservations_restaurant_id_id_key")
  @@index([restaurantId, localDate, serviceType, status, arrivalTime], map: "reservations_capacity_lookup_idx")
  @@map("reservations")
}

model ReservationAssignment {
  id               String                       @id @default(uuid()) @db.Uuid
  restaurantId     String                       @map("restaurant_id") @db.Uuid
  reservationId    String                       @map("reservation_id") @db.Uuid
  roomId           String                       @map("room_id") @db.Uuid
  internalNotes    String?                      @map("internal_notes") @db.VarChar(1000)
  assignedByUserId String                       @map("assigned_by_user_id") @db.Uuid
  updatedByUserId  String                       @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  clearedAt        DateTime?                    @map("cleared_at") @db.Timestamptz(3)
  reservation      Reservation                  @relation(fields: [restaurantId, reservationId], references: [restaurantId, id], onDelete: Restrict, map: "reservation_assignments_restaurant_reservation_fkey")
  room             Room                         @relation(fields: [restaurantId, roomId], references: [restaurantId, id], onDelete: Restrict, map: "reservation_assignments_restaurant_room_fkey")
  assignedByUser   User                         @relation("ReservationAssignmentAssignedBy", fields: [restaurantId, assignedByUserId], references: [restaurantId, id], onDelete: Restrict, map: "reservation_assignments_restaurant_assigned_by_fkey")
  updatedByUser    User                         @relation("ReservationAssignmentUpdatedBy", fields: [restaurantId, updatedByUserId], references: [restaurantId, id], onDelete: Restrict, map: "reservation_assignments_restaurant_updated_by_fkey")
  tables           ReservationAssignmentTable[]

  @@unique([restaurantId, reservationId], map: "reservation_assignments_restaurant_reservation_key")
  @@unique([restaurantId, id, roomId], map: "reservation_assignments_restaurant_id_room_key")
  @@index([restaurantId, clearedAt], map: "reservation_assignments_restaurant_cleared_idx")
  @@index([restaurantId, roomId], map: "reservation_assignments_restaurant_room_idx")
  @@map("reservation_assignments")
}

model ReservationAssignmentTable {
  restaurantId  String                @map("restaurant_id") @db.Uuid
  assignmentId  String                @map("assignment_id") @db.Uuid
  roomId        String                @map("room_id") @db.Uuid
  diningTableId String                @map("dining_table_id") @db.Uuid
  assignment    ReservationAssignment @relation(fields: [restaurantId, assignmentId, roomId], references: [restaurantId, id, roomId], onDelete: Restrict, map: "reservation_assignment_tables_assignment_room_fkey")
  room          Room                  @relation("ReservationAssignmentTableRoom", fields: [restaurantId, roomId], references: [restaurantId, id], onDelete: Restrict, map: "reservation_assignment_tables_restaurant_room_fkey")
  diningTable   DiningTable           @relation(fields: [roomId, diningTableId], references: [roomId, id], onDelete: Restrict, map: "reservation_assignment_tables_room_table_fkey")

  @@id([restaurantId, assignmentId, diningTableId], map: "reservation_assignment_tables_pkey")
  @@index([restaurantId, roomId, diningTableId], map: "reservation_assignment_tables_restaurant_room_table_idx")
  @@map("reservation_assignment_tables")
}

model ReservationIdempotencyKey {
  id            String       @id @default(uuid()) @db.Uuid
  restaurantId  String       @map("restaurant_id") @db.Uuid
  keyHash       String       @map("key_hash") @db.Char(64)
  requestHash   String       @map("request_hash") @db.Char(64)
  reservationId String?      @unique(map: "reservation_idempotency_keys_reservation_id_key") @map("reservation_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(3)
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, keyHash], map: "reservation_idempotency_keys_restaurant_key_hash_key")
  @@index([expiresAt], map: "reservation_idempotency_keys_expires_at_idx")
  @@map("reservation_idempotency_keys")
}

model ReservationManagementToken {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @unique(map: "reservation_management_tokens_reservation_id_key") @map("reservation_id") @db.Uuid
  tokenHash     String      @unique(map: "reservation_management_tokens_token_hash_key") @map("token_hash") @db.Char(64)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  viewExpiresAt DateTime    @map("view_expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(3)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([viewExpiresAt, revokedAt], map: "reservation_management_tokens_expiry_idx")
  @@map("reservation_management_tokens")
}

model PublicReservationRateLimit {
  id              String                           @id @default(uuid()) @db.Uuid
  restaurantId    String                           @map("restaurant_id") @db.Uuid
  action          PublicReservationRateLimitAction
  keyHash         String                           @map("key_hash") @db.Char(64)
  attempts        Int                              @default(1)
  windowStartedAt DateTime                         @map("window_started_at") @db.Timestamptz(3)
  expiresAt       DateTime                         @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)
  restaurant      Restaurant                       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, action, keyHash], map: "public_reservation_rate_limits_identity_key")
  @@index([expiresAt], map: "public_reservation_rate_limits_expires_at_idx")
  @@map("public_reservation_rate_limits")
}

model ReservationAuditEvent {
  id                     String                 @id @default(uuid()) @db.Uuid
  restaurantId           String                 @map("restaurant_id") @db.Uuid
  reservationId          String                 @map("reservation_id") @db.Uuid
  action                 ReservationAuditAction
  actorOrigin            ReservationOrigin      @map("actor_origin")
  actorUserId            String?                @map("actor_user_id") @db.Uuid
  actorRole              UserRole?              @map("actor_role")
  correlationId          String                 @map("correlation_id") @db.Uuid
  previousState          Json?                  @map("previous_state")
  newState               Json                   @map("new_state")
  capacityOverride       Boolean                @default(false) @map("capacity_override")
  capacityOverrideReason String?                @map("capacity_override_reason") @db.VarChar(500)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  restaurant             Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservation            Reservation            @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  actorUser              User?                  @relation("ReservationAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([reservationId, createdAt], map: "reservation_audit_events_reservation_created_idx")
  @@index([restaurantId, createdAt], map: "reservation_audit_events_restaurant_created_idx")
  @@index([actorUserId, createdAt], map: "reservation_audit_events_actor_created_idx")
  @@map("reservation_audit_events")
}

model AuditEvent {
  id            String     @id @default(uuid()) @db.Uuid
  restaurantId  String     @map("restaurant_id") @db.Uuid
  category      String     @db.VarChar(32)
  action        String     @db.VarChar(64)
  outcome       String     @db.VarChar(16)
  actorUserId   String?    @map("actor_user_id") @db.Uuid
  actorRole     UserRole?  @map("actor_role")
  entityType    String?    @map("entity_type") @db.VarChar(64)
  entityId      String?    @map("entity_id") @db.Uuid
  correlationId String     @map("correlation_id") @db.Uuid
  previousState Json?      @map("previous_state")
  newState      Json?      @map("new_state")
  metadata      Json?
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  actorUser     User?      @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([restaurantId, createdAt], map: "audit_events_restaurant_created_idx")
  @@index([restaurantId, category, action, createdAt], map: "audit_events_category_action_idx")
  @@index([actorUserId, createdAt], map: "audit_events_actor_created_idx")
  @@map("audit_events")
}
