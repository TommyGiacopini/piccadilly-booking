APP_ENV=development
DATABASE_URL=postgresql://piccadilly_dev:piccadilly_dev_password@localhost:5433/piccadilly_booking?schema=public
POSTGRES_USER=piccadilly_dev
POSTGRES_PASSWORD=piccadilly_dev_password
POSTGRES_DB=piccadilly_booking
POSTGRES_PORT=5433
AUTH_RESTAURANT_ID=00000000-0000-4000-8000-000000000001
AUTH_RATE_LIMIT_SECRET=local-only-rate-limit-secret-change-outside-development
AUTH_TRUST_PROXY=false
AUTH_DEMO_ADMIN_PASSWORD=PiccadillyDemoAdmin-Local-2026
AUTH_DEMO_STAFF_PASSWORD=PiccadillyDemoStaff-Local-2026
RESERVATION_PRIVACY_POLICY_VERSION=local-demo-v1
RESERVATION_TERMS_VERSION=local-demo-terms-v1
RESERVATION_IDEMPOTENCY_TTL_HOURS=24
# Minimo 32 caratteri; sostituire con valori distinti e stabili fuori dallo sviluppo.
PUBLIC_BOOKING_MANAGEMENT_SECRET=local-only-public-management-secret-change-outside-development
PUBLIC_BOOKING_RATE_LIMIT_SECRET=local-only-public-rate-limit-secret-change-outside-development
PUBLIC_BOOKING_RATE_LIMIT_WINDOW_SECONDS=900
PUBLIC_BOOKING_READ_LIMIT=60
PUBLIC_BOOKING_MUTATION_LIMIT=10

# M13 staging personale (solo riferimento; Render valorizza RENDER e
# RENDER_SERVICE_TYPE automaticamente e i secret restano nel secret store).
# RENDER=true
# RENDER_SERVICE_TYPE=web
# RENDER_EXTERNAL_URL=https://piccadilly-booking-demo.onrender.com
# STAGING_ACCESS_USERNAME=piccadilly-staging
# STAGING_ACCESS_PASSWORD=replace-with-staging-only-secret
# AUTH_DEMO_ADMIN_PASSWORD=replace-with-staging-demo-admin-secret
# AUTH_DEMO_STAFF_PASSWORD=replace-with-staging-demo-staff-secret

# Runner Playwright remoto M13 (processo separato, senza DATABASE_URL).
# STAGING_BASE_URL=https://piccadilly-booking-demo.onrender.com
# STAGING_ADMIN_USERNAME=demo.admin
# STAGING_ADMIN_PASSWORD=replace-with-staging-demo-admin-secret
# STAGING_STAFF_USERNAME=demo.staff
# STAGING_STAFF_PASSWORD=replace-with-staging-demo-staff-secret
# STAGING_RUN_ID=RUN-YYYYMMDD-UNIQUE
